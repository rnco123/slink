# =============================================================================
# Saludlink — Medusa v2 backend environment
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. Values below are SAFE LOCAL DEFAULTS for dev.
# NEVER commit real secrets. In production these come from Railway variables.
# =============================================================================

# --- Core -------------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development

# Postgres / Supabase connection string. Local default matches the dev docker-compose.
# Supabase Direct: postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://saludlink:saludlink_local@localhost:5432/medusa

# --- Supabase Platform Integration ------------------------------------------
# Optional keys for direct Supabase Auth, Storage, or Client API calls.
# Use the CURRENT API keys from Supabase → Project Settings → API keys:
# the publishable key (sb_publishable_...) and the secret key (sb_secret_...).
# The legacy `anon` / `service_role` JWTs are NOT accepted — boot validation
# rejects them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Redis. When set, Medusa uses Redis for the event bus, workflow engine, and
# cache. Leave EMPTY for a first boot to fall back to in-memory (dev only —
# in-memory has no durable workflows / cross-process events).
# Production: the Railway Redis service (reference it as ${{Redis.REDIS_URL}}).
REDIS_URL=redis://localhost:6379

# --- Auth secrets -----------------------------------------------------------
# Override BOTH in production with long random values (Railway variables).
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed origins.
# STORE_CORS  = the Next.js storefront (default :8000)
# ADMIN_CORS  = the Medusa admin (default :9000) + vite dev (:5173)
# AUTH_CORS   = origins allowed to hit /auth (storefront + admin)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173

# --- Admin dashboard --------------------------------------------------------
# Public URL the backend/admin is reached at.
MEDUSA_BACKEND_URL=http://localhost:9000
# Set to true on worker/API-only deployments to not build/serve the admin.
MEDUSA_ADMIN_DISABLE=false
# Redirect target after admin login flows (Medusa admin onward URL).
MEDUSA_ADMIN_ONWARD=

# --- Payments: BANK TRANSFER ------------------------------------------------
# There is no card gateway. Checkout uses Medusa's built-in system provider,
# which needs no credentials. The details below are shown to the customer at
# checkout and on the order confirmation, and are served to the storefront by
# GET /store/config — they are NOT baked into the storefront build.
#
# ⚠ Payment is NOT verified. Orders arrive AUTHORISED, NOT CAPTURED. Confirm the
# funds landed, then capture in Admin (Orders → Payments → Capture) before
# fulfilling. Never fulfil on the customer's confirmation alone.
#
# FALLBACK ONLY — the source of truth is Admin → Site Settings → Bank transfer
# details, so an account change needs no redeploy. Leave these blank and set
# them in Admin instead. Admin values win field by field.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ROUTING_NUMBER=
# Optional free-text shown under the details (e.g. "Include your order number
# as the payment reference").
BANK_TRANSFER_INSTRUCTIONS=

# --- MCM-Go integration (telehealth app) ------------------------------------
# Shared bearer token for the READ API at /integrations/mcm/*, which lets MCM-Go
# recover a missed webhook delivery, backfill order history, and answer support
# questions about what a buyer purchased.
#
# Generate: openssl rand -hex 32   (set the SAME value on the MCM-Go side)
# FAILS CLOSED — while this is unset every request to /integrations/mcm/* is
# rejected with 401. There is no open fallback.
MCM_INTEGRATION_TOKEN=

# --- Object storage: Supabase Storage (@medusajs/file-s3) -------------------
# Supabase Storage speaks the S3 protocol, so Medusa's S3 provider drives it.
# Enabled only when S3_BUCKET + S3_REGION + S3_FILE_URL are all set, otherwise
# the local file provider (./static) is used. Railway disks are ephemeral, so
# the local provider is DEV ONLY — uploads there vanish on redeploy.
#
# Supabase values (Storage → S3 Connection in the dashboard):
#   S3_ENDPOINT   https://[project-ref].supabase.co/storage/v1/s3
#   S3_FILE_URL   https://[project-ref].supabase.co/storage/v1/object/public/[bucket]
#   S3_REGION     the project region, e.g. us-east-1
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are Supabase Storage S3 keys
S3_FILE_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint of the S3-compatible store. Required for Supabase Storage (and R2 /
# MinIO); leave empty only for genuine AWS S3.
S3_ENDPOINT=

# --- Resend email (src/modules/notification-resend) -------------------------
# Enabled only when RESEND_API_KEY + RESEND_FROM are set, else the local (logs)
# provider. Order emails name health products → sign a Resend BAA before real
# sends in production (task 39).
RESEND_API_KEY=
RESEND_FROM=no-reply@saludlinkusa.com
